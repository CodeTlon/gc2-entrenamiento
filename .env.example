# Copiar a .env.development.local / .env.test.local / .env.production.local (gitignored). Nunca NEXT_PUBLIC_ para secretos.
APP_ENV=development                  # development | test | production

# Base (Postgres). dev: docker compose; test/prod: Coolify
DATABASE_URL=postgres://app:app@127.0.0.1:42432/app
# En Coolify con puerto publico: ?sslmode=require&uselibpqcompat=true (ver docs/environments.md)
DB_POOL_MAX=3

# Auth (Better Auth)
BETTER_AUTH_SECRET=                  # openssl rand -base64 32, distinto por entorno
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=         # opcional, coma-separados

# Archivos (S3-compatible: Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                  # base publica de las URLs (dominio del bucket)
S3_REGION=auto

# Correo (Resend). En test: estandar de pruebas CodeTlon (MAIL_SANDBOX_TO obligatorio); en prod NO definir MAIL_SANDBOX_TO
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MAIL_SANDBOX_TO=
COMPANY_EMAIL=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
